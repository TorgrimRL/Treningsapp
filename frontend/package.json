{
  "name": "treningsapp",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:ios": "CAPACITOR_BUILD=true react-router build --mode ios",
    "dev": "react-router dev",
    "ios:open": "open -a Xcode ios/App/App.xcodeproj",
    "ios:sync": "npm run build:ios && cap sync ios",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "start": "react-router-serve build/server/nodejs_*/index.js",
    "dev:e2e": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.26.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fortawesome/fontawesome-svg-core": "^6.5.2",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^7.18.2",
    "@tanstack/react-query": "^5.103.1",
    "@vercel/react-router": "^1.3.6",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.2.1",
    "react-modal": "^3.16.1",
    "react-router": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^7.18.2",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "eslint": "^8.38.0",
    "eslint-plugin-import": "^2.28.1",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
