# Shared API base URL. Use an HTTPS endpoint for device builds.
VITE_API_URL=https://api.example.com/api

# Auth0 Native application settings for the Capacitor iOS build.
# The client ID is public; never add an Auth0 Client Secret to the frontend.
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_IOS_CLIENT_ID=your-native-client-id
VITE_AUTH0_AUDIENCE=https://api.setoptimizer.com

# Optional feature flag for the guided onboarding experience.
VITE_ONBOARDING_V1_ENABLED=true
