#!/usr/bin/env bash
set -euo pipefail

staged_files=$(git diff --cached --name-only --diff-filter=ACMR)

if printf "%s\n" "$staged_files" | grep -q "^frontend/"; then
  echo "Running frontend lint before commit..."
  (cd frontend && npm run lint)
else
  echo "No staged frontend changes detected; skipping lint."
fi
