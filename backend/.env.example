# Existing web Auth0 application settings
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your-web-client-id
AUTH0_CLIENT_SECRET=keep-this-server-side
AUTH0_SECRET=generate-a-long-random-session-secret
AUTH0_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# Shared Auth0 API identifier used to validate native access tokens
AUTH0_AUDIENCE=https://api.setoptimizer.com

JWT_SECRET_KEY=generate-a-long-random-jwt-secret
